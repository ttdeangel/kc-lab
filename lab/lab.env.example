# lab/lab.env - settings for the lab scripts (kc-lab.sh, setup.sh, e2e-local.sh).
#   cp lab/lab.env.example lab/lab.env   (lab/lab.env is git-ignored)
# Every value can also be overridden on the command line:  CLUSTER=x ./lab/kc-lab.sh up
#
# Defaults are chosen so this lab runs NEXT TO an existing kind + Kubecost lab without touching it:
# its own cluster name, its own host port and its own work directory, in the same Colima VM.

# --- cluster and Kubecost
CLUSTER=kcresize-lab              # kind cluster name = Kubecost clusterId (must differ from any existing lab)
UI_PORT=9091                      # host port for this lab's Kubecost UI/API (an existing lab usually has 9090)
KUBECOST_URL=http://localhost:9091
KUBECOST_FREE=1                   # free tier (Actions up to 250 cores); or set LICENSE_FILE=./productkey.json
WORKDIR=./.lab/kcresize-lab       # generated values, signing keys, credentials (git-ignored)

# --- container runtime (macOS)
COLIMA_PROFILE=default            # reuse the running Colima VM; a separate profile only adds VM overhead
COLIMA_CPU=4                      # used only when this script has to START Colima
COLIMA_MEM=16
COLIMA_DISK=60
STOP_COLIMA_ON_DESTROY=0          # 1 = also stop Colima on destroy (only if no other kind clusters remain)

# --- sample workloads
LEGACY_WORKLOADS=0                # 1 = also deploy the old resource-hog / oversized-idle samples (resource-hog burns ~2 cores)

# --- people (rendered into .github/kcresize.json by: ./lab/setup.sh config)
OWNER_GITHUB=                     # default: your gh login
OWNER_EMAIL=
ACTIONING_GITHUB=                 # default: same as OWNER_GITHUB (in the lab you play both roles)
ACTIONING_EMAIL=                  # default: same as OWNER_EMAIL
APPROVAL_LABEL=kcresize.io/approval=required

# --- GitHub runner
RUNNER_LABEL=kcresize-lab
RUNNER_DIR=$HOME/actions-runner-kcresize-lab

# --- basic-auth proxy (./lab/kc-lab.sh share)
BASIC_USER=kubecost
