{
  "_comment": "Lab budgets (50). Synced to Kubecost by .github/workflows/kcbudget-lab.yml. Slack/Teams entries are channel NAMES resolved at runtime on the runner from KCBUDGET_WEBHOOKS (see docs/budgets.md, Runtime settings); no URLs or secrets live in GitHub. Emails are example.com placeholders: replace with real lab recipients.",
  "environment": "lab",
  "managedPrefix": "kcb-",
  "allowedEmailDomains": [
    "example.com"
  ],
  "defaults": {
    "kind": "soft",
    "interval": "monthly",
    "intervalDay": 1
  },
  "pools": {
    "bu-commerce": {
      "monthlyLimit": 1000,
      "description": "Commerce business unit - monthly allocation"
    },
    "bu-platform": {
      "monthlyLimit": 1000,
      "description": "Platform engineering - monthly allocation"
    },
    "bu-data": {
      "monthlyLimit": 700,
      "description": "Data and ML - monthly allocation"
    }
  },
  "budgets": [
