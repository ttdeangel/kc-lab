# ~/.kcbudget/<github-environment>.env on the runner (e.g. ~/.kcbudget/kcbudget-lab.env), chmod 600.
# Loaded at runtime by kcbudget; nothing here is stored in GitHub. Only KUBECOST_*, KCBUDGET_* and
# KCRESIZE_SMTP_* keys are accepted. Values already in the runner's environment take precedence.

KUBECOST_URL=http://localhost:9090           # lab default; `kcctl env` shows the port if 9090 was taken
# KUBECOST_UI_URL=http://localhost:9090          # link shown in alerts
# KUBECOST_AUTH_HEADER=Authorization: Bearer xxx  # or KUBECOST_BASIC_USER / KUBECOST_BASIC_PASSWORD

# Slack / Teams URLs by channel name (same shape as webhooks.example.json): inline JSON or a file path
KCBUDGET_WEBHOOKS_FILE=/home/runner/.kcbudget/kcbudget-lab.webhooks.json

# SMTP, only for `check --channels email`
# KCRESIZE_SMTP_HOST=smtp.office365.com
# KCRESIZE_SMTP_PORT=587
# KCRESIZE_SMTP_USER=finops-bot@example.com
# KCRESIZE_SMTP_PASSWORD=
# KCRESIZE_SMTP_FROM=Kubecost Budgets <finops-bot@example.com>
